# Environment Variables — Root Level
# Copy this to .env and fill in your values
# NEVER commit .env files with real secrets

# ─── Firebase Admin SDK (Backend) ─────────────────────────────────────────────
# Service account credentials: obtained from Firebase Console → Project Settings → Service Accounts
# For local dev, set the path to your downloaded service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your-service-account.json

# ─── Firebase Project ─────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id

# ─── Gemini API ───────────────────────────────────────────────────────────────
# For local dev: set directly (never commit the real key)
# For production: retrieved from Google Cloud Secret Manager automatically
GEMINI_API_KEY=your-gemini-api-key-here

# ─── Google Cloud ─────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Secret Manager secret name for the Gemini API key
GEMINI_SECRET_NAME=gemini-api-key

# ─── Backend Server ───────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Frontend origin allowed to call the backend
FRONTEND_URL=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
