# Frontend Environment Variables
# Copy this to .env.local and fill in real values from Firebase Console
# NEVER commit .env.local

# Firebase Configuration (these are PUBLIC — safe to include in frontend)
# Found in: Firebase Console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Backend API URL
# Development: http://localhost:8080
# Production: your Cloud Run service URL
VITE_API_URL=http://localhost:8080
